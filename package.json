{
  "name": "@giildo/fexios",
  "version": "2.1.0",
  "description": "Library for making AJAX calls based on the fetch API",
  "keywords": [
    "ajax",
    "axios",
    "browser",
    "fetch",
    "http",
    "node",
    "promise"
  ],
  "homepage": "https://github.com/Giildo/fexios#readme",
  "bugs": {
    "url": "https://github.com/Giildo/fexios/issues"
  },
  "license": "LGPL-3.0-or-later",
  "author": "Giildo <giildo.jm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Giildo/fexios.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fexios.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fexios.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "run-s type-check build-only",
    "build-only": "vite build",
    "check": "run-s lint format",
    "dev": "vite",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt .",
    "docs:build": "pnpm -C docs build",
    "docs:dev": "pnpm -C docs dev",
    "docs:preview": "pnpm -C docs preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:mutation:diff": "stryker run --mutate \"$(git diff --name-only HEAD | grep -E '^src/.*\\.ts$' | paste -sd, -)\"",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.23.0"
}
